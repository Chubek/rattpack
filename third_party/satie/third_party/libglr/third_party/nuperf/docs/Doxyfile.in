PROJECT_NAME           = "NuPERF"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Minimal perfect hash table generator"
OUTPUT_DIRECTORY       = "@NUPERF_DOCS_OUTPUT_DIR@"
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@NUPERF_DOCS_STRIP_FROM_PATH@"
LAYOUT_FILE            = "@NUPERF_DOCS_LAYOUT_FILE@"

INPUT                  = "@CMAKE_SOURCE_DIR@/include/nuperf" \
                         "@CMAKE_SOURCE_DIR@/src" \
                         "@CMAKE_SOURCE_DIR@/docs/manual"
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.c *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = "@CMAKE_SOURCE_DIR@/third_party" \
                         "@CMAKE_BINARY_DIR@"

USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/docs/frontpage.md"
MARKDOWN_SUPPORT       = YES

WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = "@NUPERF_DOCS_WARN_LOG@"

GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO
GENERATE_SQLITE3       = NO
GENERATE_MARKDOWN      = NO

HAVE_DOT               = @NUPERF_HAVE_DOT@
