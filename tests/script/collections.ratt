import "collections"
let numbers = collections.map([1, 2, 3], fn(n) { return n * 2 })
print(numbers)
print(collections.filter(numbers, fn(n) { return n > 2 }))
print(collections.fold(numbers, 0, fn(a, b) { return a + b }))
print(set([3, 1, 3]), {z: 2, a: 1})
let entries = ["!", "not", "(", ")", "if"]
print(entries[-1], entries.length)
