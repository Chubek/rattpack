# phase: construction
import "semver"
print(semver.parse("1.2.3-alpha.1+build.7"))
print(semver.valid("1.2.3"), semver.valid("01.2.3"), semver.valid("1.2.3-01"))
print(semver.compare("1.0.0+one", "1.0.0+two"), semver.compare("1.0.0-2", "1.0.0-alpha"))
print(semver.sort(["1.0.0", "2.0.0", "1.0.0-beta", "1.0.0-alpha.10", "1.0.0-alpha.2"]))
print(semver.bump("1.2.3-alpha+build"), semver.bump("1.2.3", "minor"), semver.bump("1.2.3", "major"))
assert(not semver.valid("1.2") and not semver.valid("v1.2.3"))
assert(not semver.valid("1.2.3\n") and not semver.valid("1.2.3-alpha..beta"))
assert(not semver.valid("9223372036854775808.0.0"))
assert(semver.valid("9223372036854775807.0.0"))
assert(semver.valid("1.2.3+01"))
assert(semver.compare("1.0.0-999999999999999999999", "1.0.0-1000000000000000000000") == -1)
assert(semver.compare("1.0.0-alpha", "1.0.0-alpha.1") == -1)
assert(semver.sort([]) == [])
