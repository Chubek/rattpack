# Checked integer helpers and portable floating-point primitives.
let pi = _native.pi
let e = _native.e

fn abs(value: float) {
    if value < 0 { return -value }
    return +value
}

fn sign(value: float) -> int {
    if value < 0 { return -1 }
    if value > 0 { return 1 }
    return 0
}

fn min(left: float, right: float) { if left < right { return left } return right }
fn max(left: float, right: float) { if left > right { return left } return right }

fn clamp(value: float, lower: float, upper: float) {
    assert(lower <= upper, "math.clamp lower must not exceed upper")
    return min(max(value, lower), upper)
}

fn pow(base: float, exponent: int) {
    let power = exponent
    # Avoid negating int.min: the largest negative exponent can be handled too.
    let result: float = 1
    let factor = base
    if power < 0 { power = -(power + 1); factor = 1.0 / base }
    while power > 0 {
        if power % 2 == 1 { result *= factor }
        power = power / 2
        if power > 0 { factor *= factor }
    }
    if exponent < 0 { return float(result) / base }
    return result
}

fn gcd(left: int, right: int) -> int {
    let a = left
    let b = right
    while b != 0 {
        # Avoid int.min % -1 and keep int.min inputs representable until the end.
        if b == -1 { return 1 }
        let remainder = a % b
        a = b
        b = remainder
    }
    return abs(a)
}

fn lcm(left: int, right: int) -> int {
    if left == 0 or right == 0 { return 0 }
    return abs((left / gcd(left, right)) * right)
}

fn sqrt(value: float) -> float { return _native.sqrt(value) }
fn floor(value: float) -> float { return _native.floor(value) }
fn ceil(value: float) -> float { return _native.ceil(value) }
fn round(value: float) -> float { return _native.round(value) }
fn log(value: float) -> float { return _native.log(value) }
fn exp(value: float) -> float { return _native.exp(value) }
fn sin(value: float) -> float { return _native.sin(value) }
fn cos(value: float) -> float { return _native.cos(value) }
fn tan(value: float) -> float { return _native.tan(value) }
fn is_finite(value: float) -> bool { return _native.is_finite(value) }
