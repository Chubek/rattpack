project(name: @{dirname_literal}, version: "0.1.0", kind: "monorepo")
monorepo {
  # member "libs/example"
  # vendored "third_party/example"
  # ignore "third_party/legacy"
}
import "fs"
let welcome = rule(name: "welcome", output: "build/welcome.txt")
action(welcome) { fs.write("build/welcome.txt", @{welcome_literal}) }
