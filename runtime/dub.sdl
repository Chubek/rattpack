name "runtime"
description "Shared Rattpack runtime"
targetType "dynamicLibrary"
targetName "rattpack"
targetPath "../build"
sourcePaths "../source/rattpack"
importPaths "../source"
stringImportPaths "../stdlib" "../profiles"
dflags "-preview=dip1000"
dflags "-link-defaultlib-shared" platform="ldc"
dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
dependency "toml" version="==2.0.1"
dependency "dyaml" version="==0.10.0"
dependency "requests" version="==2.2.1"
dependency "semver" version="==0.8.0"
dependency "msgpack-d" version="==1.0.5"
dependency "taggedalgebraic" version="==1.0.1"
dependency "emsi_containers" version="==0.9.0"
dependency "argparse" version="==2.1.0"
dependency "arsd-official:terminal" version="==12.1.2"
preBuildCommands "python3 ../tools/build-native.py" platform="posix"
preBuildCommands "python ../tools/build-native.py" platform="windows"
libs "rattnative" "rattgit" "rattxz" "rattz"
libs "ssl" "crypto" platform="posix"
libs "iconv" platform="osx"
lflags "-framework" "Security" "-framework" "CoreFoundation" platform="osx"
libs "crypt32" "secur32" "ws2_32" "winhttp" platform="windows"
lflags "-Lbuild"
